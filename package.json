{
  "name": "dsh-read-url",
  "version": "0.5.0",
  "description": "DeepSeek Harness URL reader: fetch any webpage, auto-detect encoding (GBK/GB2312/UTF-8/Big5), extract clean main content, output compact text/Markdown to save tokens. Web-UI settings card (DSH rc.7+), one schema-only dependency.",
  "type": "module",
  "main": "index.js",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "files": [
    "index.js",
    "spa.js",
    "proxy-fallback.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2672243194/dsh-read-url.git"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "readability",
    "web",
    "markdown",
    "reader",
    "url-reader"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
